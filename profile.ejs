<%- include('partials/header') %>
<%- include('partials/nav') %>
<main class="content-section page-top">
    <p class="eyebrow">PLAYER PROFILE</p>
    <h1><%= profile.display_name %></h1>
    <section class="profile-layout">
        <div class="profile-card pixel-panel">
            <div class="avatar">SP</div>
            <h2><%= profile.username %></h2>
            <p class="role-badge"><%= profile.role %></p>
            <p>Joined <%= new Date(profile.created_at).toLocaleDateString() %></p>
            <dl class="profile-summary">
                <dt>Favorite game</dt>
                <dd><%= profile.favorite_game || 'Not set' %></dd>
                <dt>Favorite genre</dt>
                <dd><%= profile.favorite_game_genre || 'Not set' %></dd>
                <dt>Favorite company</dt>
                <dd><%= profile.favorite_game_company || 'Not set' %></dd>
                <dt>Consoles owned</dt>
                <dd><%= profile.consoles_owned.length ? profile.consoles_owned.join(', ') : 'None selected' %></dd>
                <dt>Consoles wanted</dt>
                <dd><%= profile.consoles_wanted.length ? profile.consoles_wanted.join(', ') : 'None selected' %></dd>
            </dl>
        </div>

        <form action="/profile" method="POST" class="stack-form pixel-panel profile-form">
            <h2>Edit Profile</h2>
            <label>
                Display name
                <input name="displayName" value="<%= profile.display_name || '' %>" required>
            </label>
            <label>
                Email
                <input type="email" name="email" value="<%= profile.email || '' %>">
            </label>
            <label>
                Favorite console company
                <select name="favoriteConsoleCompany">
                    <option value="">Choose one</option>
                    <% options.consoleCompanies.forEach((company) => { %>
                        <option value="<%= company %>" <%= profile.favorite_console_company === company ? 'selected' : '' %>><%= company %></option>
                    <% }) %>
                </select>
            </label>
            <label>
                Favorite game company
                <select name="favoriteGameCompany">
                    <option value="">Choose one</option>
                    <% options.gameCompanies.forEach((company) => { %>
                        <option value="<%= company %>" <%= profile.favorite_game_company === company ? 'selected' : '' %>><%= company %></option>
                    <% }) %>
                </select>
            </label>
            <label>
                Favorite game genre
                <select name="favoriteGameGenre">
                    <option value="">Choose one</option>
                    <% options.gameGenres.forEach((genre) => { %>
                        <option value="<%= genre %>" <%= profile.favorite_game_genre === genre ? 'selected' : '' %>><%= genre %></option>
                    <% }) %>
                </select>
            </label>
            <label>
                Favorite game
                <input name="favoriteGame" maxlength="150" value="<%= profile.favorite_game || '' %>" placeholder="e.g. Chrono Trigger">
            </label>
            <fieldset class="choice-group">
                <legend>Consoles owned</legend>
                <div class="choice-grid">
                    <% options.gameConsoles.forEach((consoleName) => { %>
                        <label class="choice-card">
                            <input type="checkbox" name="consolesOwned" value="<%= consoleName %>" <%= profile.consoles_owned.includes(consoleName) ? 'checked' : '' %>>
                            <span><%= consoleName %></span>
                        </label>
                    <% }) %>
                </div>
            </fieldset>
            <fieldset class="choice-group">
                <legend>Consoles wanted</legend>
                <div class="choice-grid">
                    <% options.gameConsoles.forEach((consoleName) => { %>
                        <label class="choice-card">
                            <input type="checkbox" name="consolesWanted" value="<%= consoleName %>" <%= profile.consoles_wanted.includes(consoleName) ? 'checked' : '' %>>
                            <span><%= consoleName %></span>
                        </label>
                    <% }) %>
                </div>
            </fieldset>
            <label>
                Bio
                <textarea name="bio" rows="5"><%= profile.bio || '' %></textarea>
            </label>
            <button class="primary-button">Save Profile</button>
        </form>

        <form action="/profile/password" method="POST" class="stack-form pixel-panel profile-form">
            <h2>Change password</h2>
            <label>
                Current password
                <input type="password" name="currentPassword" autocomplete="current-password" required>
            </label>
            <label>
                New password
                <input type="password" name="newPassword" minlength="8" autocomplete="new-password" required>
            </label>
            <label>
                Confirm new password
                <input type="password" name="confirmPassword" minlength="8" autocomplete="new-password" required>
            </label>
            <button class="primary-button">Update Password</button>
        </form>
    </section>
</main>
<%- include('partials/footer') %>
