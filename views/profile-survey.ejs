<%- include('partials/header') %>
<%- include('partials/nav') %>
<main class="content-section page-top">
    <section class="survey-intro">
        <p class="eyebrow">OPTIONAL NEW PLAYER SETUP</p>
        <h1>Build Your SavePoint Profile</h1>
        <p class="lead">
            Share your gaming interests now, or skip this step and edit them
            later from Profile in the navbar.
        </p>
    </section>

    <% if (error) { %>
        <div class="alert"><%= error %></div>
    <% } %>

    <section class="pixel-panel savepoint-survey">
        <form action="/profile/setup" method="POST" class="stack-form">
            <p class="profile-form-help">
                Every question is optional. The suggestions are examples;
                you may enter any answer.
            </p>

            <label>
                Favorite game company?
                <input
                    name="favoriteGameCompany"
                    value="<%= profile.favorite_game_company || '' %>"
                    list="game-company-options"
                    maxlength="150"
                    placeholder="e.g. Capcom"
                >
            </label>

            <label>
                Favorite game genre?
                <input
                    name="favoriteGameGenre"
                    value="<%= profile.favorite_game_genre || '' %>"
                    list="game-genre-options"
                    maxlength="150"
                    placeholder="e.g. RPG"
                >
            </label>

            <label>
                Favorite game?
                <input
                    name="favoriteGame"
                    value="<%= profile.favorite_game || '' %>"
                    maxlength="150"
                    placeholder="e.g. Chrono Trigger"
                >
            </label>

            <label>
                What consoles do you own?
                <textarea
                    name="consolesOwned"
                    rows="3"
                    maxlength="1000"
                    placeholder="e.g. Nintendo DS, PSP, PlayStation 2"
                ><%= profile.consoles_owned || '' %></textarea>
            </label>

            <label>
                Eyeing any consoles?
                <textarea
                    name="consolesWanted"
                    rows="3"
                    maxlength="1000"
                    placeholder="e.g. Sega Dreamcast"
                ><%= profile.consoles_wanted || '' %></textarea>
            </label>

            <datalist id="game-company-options">
                <% suggestions.gameCompanies.forEach((company) => { %>
                    <option value="<%= company %>"></option>
                <% }) %>
            </datalist>

            <datalist id="game-genre-options">
                <% suggestions.gameGenres.forEach((genre) => { %>
                    <option value="<%= genre %>"></option>
                <% }) %>
            </datalist>

            <datalist id="platform-options">
                <% suggestions.platforms.forEach((platform) => { %>
                    <option value="<%= platform %>"></option>
                <% }) %>
            </datalist>

            <datalist id="console-options">
                <% suggestions.gameConsoles.forEach((consoleName) => { %>
                    <option value="<%= consoleName %>"></option>
                <% }) %>
            </datalist>

            <div class="survey-actions">
                <button class="primary-button" type="submit">
                    Save Profile
                </button>
            </div>
        </form>

        <form action="/profile/setup/skip" method="POST" class="skip-survey-form">
            <button class="secondary-button" type="submit">
                Skip for now
            </button>
        </form>
    </section>
</main>
<%- include('partials/footer') %>
