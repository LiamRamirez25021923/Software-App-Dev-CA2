<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout – bouTime</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .checkout-container {
      background-color: #f8f9fa;
      padding: 20px;
      border-radius: 8px;
    }
    .checkout-form {
      background-color: white;
      padding: 30px;
      border-radius: 8px;
      border: 2px solid #242e57;
      margin-bottom: 20px;
    }
    .form-section {
      margin-bottom: 30px;
    }
    .form-section h4 {
      color: #242e57;
      font-weight: 700;
      margin-bottom: 15px;
      border-bottom: 2px solid #ffb300;
      padding-bottom: 10px;
    }
    .form-group {
      margin-bottom: 15px;
    }
    .form-group label {
      color: #242e57;
      font-weight: 600;
      margin-bottom: 5px;
    }
    .form-control {
      border: 1px solid #ddd;
      border-radius: 4px;
      padding: 10px;
    }
    .form-control:focus {
      border-color: #ffb300;
      box-shadow: 0 0 0 0.2rem rgba(255, 179, 0, 0.25);
    }
    .order-summary {
      background-color: white;
      border: 2px solid #242e57;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 20px;
    }
    .order-item {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid #e0e0e0;
    }
    .order-item:last-child {
      border-bottom: none;
    }
    .order-total {
      font-size: 20px;
      font-weight: 700;
      color: #ffb300;
      display: flex;
      justify-content: space-between;
      padding-top: 15px;
      border-top: 2px solid #e0e0e0;
    }
    .submit-btn {
      background-color: #ffb300;
      color: #242e57;
      border: none;
      padding: 12px 30px;
      font-weight: 700;
      border-radius: 4px;
      cursor: pointer;
      font-size: 16px;
      width: 100%;
      margin-top: 20px;
    }
    .submit-btn:hover {
      background-color: #e6a000;
    }
    .back-link {
      color: #242e57;
      text-decoration: none;
      font-weight: 600;
      margin-bottom: 20px;
      display: inline-block;
    }
    .back-link:hover {
      color: #ffb300;
    }
    .row-cols-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }
    @media (max-width: 768px) {
      .row-cols-layout {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <a href="/cart" class="back-link">← Back to Cart</a>
    <h2 class="text-center fw-bold mb-4" style="color: #242e57;">Checkout</h2>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">
      <!-- Checkout Form -->
      <div>
        <form action="/checkout" method="POST" class="checkout-form">
          <!-- Shipping Information -->
          <div class="form-section">
            <h4>Shipping Address</h4>
            <div class="form-group">
              <label for="firstName">First Name *</label>
              <input type="text" class="form-control" id="firstName" name="firstName" required>
            </div>
            <div class="form-group">
              <label for="lastName">Last Name *</label>
              <input type="text" class="form-control" id="lastName" name="lastName" required>
            </div>
            <div class="form-group">
              <label for="email">Email *</label>
              <input type="email" class="form-control" id="email" name="email" required>
            </div>
            <div class="form-group">
              <label for="phone">Phone Number</label>
              <input type="tel" class="form-control" id="phone" name="phone">
            </div>
            <div class="form-group">
              <label for="address">Street Address *</label>
              <input type="text" class="form-control" id="address" name="address" required>
            </div>
            <div class="row-cols-layout">
              <div class="form-group">
                <label for="city">City *</label>
                <input type="text" class="form-control" id="city" name="city" required>
              </div>
              <div class="form-group">
                <label for="state">State/Province</label>
                <input type="text" class="form-control" id="state" name="state">
              </div>
            </div>
            <div class="form-group">
              <label for="zipCode">ZIP/Postal Code</label>
              <input type="text" class="form-control" id="zipCode" name="zipCode">
            </div>
          </div>

          <!-- Shipping Method -->
          <div class="form-section">
            <h4>Shipping Method</h4>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="shipping" id="standard" value="standard" checked>
              <label class="form-check-label" for="standard">
                Standard Shipping (5-7 business days) - Free
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="shipping" id="express" value="express">
              <label class="form-check-label" for="express">
                Express Shipping (2-3 business days) - $9.99
              </label>
            </div>
          </div>

          <!-- Payment Information -->
          <div class="form-section">
            <h4>Payment Information</h4>
            <div class="form-group">
              <label for="cardName">Cardholder Name *</label>
              <input type="text" class="form-control" id="cardName" name="cardName" required>
            </div>
            <div class="form-group">
              <label for="cardNumber">Card Number *</label>
              <input type="text" class="form-control" id="cardNumber" name="cardNumber" placeholder="1234 5678 9012 3456" required>
            </div>
            <div class="row-cols-layout">
              <div class="form-group">
                <label for="expiry">Expiration Date *</label>
                <input type="text" class="form-control" id="expiry" name="expiry" placeholder="MM/YY" required>
              </div>
              <div class="form-group">
                <label for="cvv">CVV *</label>
                <input type="text" class="form-control" id="cvv" name="cvv" placeholder="123" required>
              </div>
            </div>
          </div>

          <button type="submit" class="submit-btn">Place Order</button>
        </form>
      </div>

      <!-- Order Summary -->
      <div>
        <div class="order-summary">
          <h5 style="color: #242e57; margin-bottom: 15px; font-weight: 700;">Order Summary</h5>
          <% if (cart && cart.length > 0) { %>
            <% cart.forEach((item) => { %>
              <div class="order-item">
                <div>
                  <div style="font-weight: 600; color: #242e57;"><%= item.product.name %></div>
                  <div style="color: #666; font-size: 14px;">Qty: <%= item.quantity %></div>
                  <% if (item.size) { %>
                    <div style="color: #666; font-size: 14px;">Size: <%= item.size %></div>
                  <% } %>
                </div>
                <div style="font-weight: 600; color: #242e57;">
                  $<%= (item.product.price * item.quantity).toFixed(2) %>
                </div>
              </div>
            <% }) %>
            <div class="order-total">
              <span>Total:</span>
              <span>$<%= total %></span>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
