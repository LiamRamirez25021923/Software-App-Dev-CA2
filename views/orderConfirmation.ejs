<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmation – bouTime</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .confirmation-container {
      background: linear-gradient(135deg, #242e57 0%, #1a1f3a 100%);
      border-radius: 8px;
      padding: 40px;
      text-align: center;
      color: white;
      margin: 40px 0;
    }
    .confirmation-icon {
      width: 80px;
      height: 80px;
      background-color: #ffb300;
      color: #242e57;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
      margin: 0 auto 20px;
    }
    .confirmation-number {
      font-size: 24px;
      font-weight: 700;
      color: #ffb300;
      margin: 20px 0;
    }
    .order-details {
      background-color: white;
      color: #242e57;
      padding: 30px;
      border-radius: 8px;
      margin: 30px 0;
      text-align: left;
    }
    .detail-row {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid #e0e0e0;
    }
    .detail-row:last-child {
      border-bottom: none;
    }
    .detail-label {
      font-weight: 600;
      color: #242e57;
    }
    .detail-value {
      color: #666;
    }
    .success-message {
      background-color: #d4edda;
      border: 1px solid #c3e6cb;
      color: #155724;
      padding: 15px;
      border-radius: 4px;
      margin-bottom: 20px;
    }
    .continue-btn {
      background-color: #ffb300;
      color: #242e57;
      border: none;
      padding: 12px 30px;
      font-weight: 700;
      border-radius: 4px;
      cursor: pointer;
      font-size: 16px;
      text-decoration: none;
      display: inline-block;
    }
    .continue-btn:hover {
      background-color: #e6a000;
      color: #242e57;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <div class="confirmation-container">
      <div class="confirmation-icon">✓</div>
      <h1>Order Confirmed!</h1>
      <p style="font-size: 18px; margin-top: 10px;">Thank you for your purchase</p>
      <div class="confirmation-number">Order #<%= Math.random().toString(36).substring(2, 11).toUpperCase() %></div>
    </div>

    <div class="success-message">
      <strong>Success!</strong> Your order has been successfully placed. You will receive a confirmation email shortly at <strong><%= order.email %></strong> with tracking information.
    </div>

    <div class="order-details">
      <h5 style="color: #242e57; margin-bottom: 20px; font-weight: 700;">Delivery Information</h5>
      <div class="detail-row">
        <span class="detail-label">Name:</span>
        <span class="detail-value"><%= order.firstName %> <%= order.lastName %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Email:</span>
        <span class="detail-value"><%= order.email %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Phone:</span>
        <span class="detail-value"><%= order.phone || 'Not provided' %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Address:</span>
        <span class="detail-value">
          <%= order.address %>, <%= order.city %><% if (order.state) { %>, <%= order.state %><% } %><% if (order.zipCode) { %> <%= order.zipCode %><% } %>
        </span>
      </div>
    </div>

    <div class="text-center my-4">
      <a href="/" class="continue-btn">Continue Shopping</a>
    </div>

    <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin-top: 30px;">
      <h5 style="color: #242e57; margin-bottom: 15px;">What's Next?</h5>
      <ul style="color: #666; line-height: 1.8;">
        <li>A confirmation email has been sent to your inbox</li>
        <li>You can track your order status at any time in your account</li>
        <li>Expected delivery within 5-7 business days</li>
        <li>If you have any questions, please contact our support team at <strong>support@boutime.com</strong></li>
      </ul>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
