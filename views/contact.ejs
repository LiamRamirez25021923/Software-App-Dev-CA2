<%- include('partials/header') %>
<%- include('partials/nav') %>
<main class="content-section page-top">
  <p class="eyebrow">CONTACT US</p>
  <h1>Contact SavePoint</h1>
  <p class="page-intro">Need help, want to share feedback, or have a question about SavePoint? Send a message to our support inbox and we will review it directly.</p>

  <% if (success) { %>
    <div class="alert success"><%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert"><%= error %></div>
  <% } %>

  <section class="content-grid two-up">
    <div class="pixel-panel card-panel">
      <h2>Get in touch</h2>
      <ul class="info-list">
        <li><strong>Email:</strong> support@savepoint.com</li>
        <li><strong>Inbox:</strong> SavePoint support mailbox</li>
        <li><strong>Hours:</strong> Monday to Friday, 9:00 AM – 6:00 PM</li>
      </ul>
    </div>

    <div class="pixel-panel card-panel">
      <h2>Send us a message</h2>
      <form action="/contact" method="POST" class="stack-form">
        <label>Name<input name="name" type="text" placeholder="Your name" required></label>
        <label>Email<input name="email" type="email" placeholder="Your email" required></label>
        <label>Subject<input name="subject" type="text" placeholder="What is this about?"></label>
        <label>Message<textarea name="message" rows="6" placeholder="How can we help?" required></textarea></label>
        <button class="primary-button" type="submit">Send Message</button>
      </form>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
