<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us – bouTime</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background: url('/images/RyanGarcia.jpg') no-repeat center center / cover;
      min-height: 100vh;
      color: #fff;
    }
    .contact-shell {
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(6px);
      border-radius: 1rem;
      box-shadow: 0 0 50px rgba(0,0,0,0.35);
      padding: 2.5rem;
    }
    .contact-shell h1,
    .contact-shell p,
    .contact-shell label,
    .contact-shell .form-control,
    .contact-shell .alert,
    .contact-shell .btn {
      color: #fff;
    }
    .contact-shell .form-control {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.25);
      color: #fff;
    }
    .contact-shell .form-control::placeholder {
      color: rgba(255,255,255,0.7);
    }
    .contact-shell .form-control:focus {
      background: rgba(255,255,255,0.15);
      color: #fff;
      border-color: #7b93ff;
      box-shadow: 0 0 0 0.25rem rgba(123,147,255,0.2);
    }
    .contact-shell .btn-primary {
      background: #2f57ff;
      border-color: #2f57ff;
    }
    .contact-shell .btn-primary:hover {
      background: #1e3dcc;
      border-color: #1e3dcc;
    }
    .contact-shell .alert {
      background: rgba(40, 167, 69, 0.15);
      border-color: rgba(40, 167, 69, 0.35);
      color: #e8f9ec;
    }
    .contact-shell .contact-info {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 0.75rem;
      padding: 1.5rem;
    }
  </style>
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container mt-5 mb-5">
    <div class="row justify-content-center">
      <div class="col-lg-10 contact-shell">
        <div class="row justify-content-center">
          <div class="col-md-7">

            <h1 class="mb-1">Contact Us</h1>
        <p class="text-muted mb-4">Got a question? We'd love to hear from you.</p>

        <% if (submitted) { %>
          <div class="alert alert-success">
            ✅ Message sent! We'll get back to you soon.
          </div>
        <% } %>

        <form action="/contact" method="POST">
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Name</label>
              <input type="text" name="name" class="form-control" placeholder="Muhammad Ali" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Email</label>
              <input type="email" name="email" class="form-control" placeholder="ali@boutime.com" required>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Subject</label>
            <input type="text" name="subject" class="form-control" placeholder="e.g. Order enquiry" required>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Message</label>
            <textarea name="message" class="form-control" rows="5" placeholder="Write your message here..." required></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-lg w-100">Send Message</button>
        </form>
      </div>

      <div class="col-md-4 offset-md-1 mt-4 mt-md-0 contact-info">
        <h5 class="fw-bold">bouTime Support</h5>
        <hr class="border-light">
        <p>📧 support@boutime.com</p>
        <p>📞 +65 9123 4567</p>
        <p>🕐 Mon–Fri, 9am–6pm SGT</p>
        <p>📍 123 Boxing Street, Singapore 123456</p>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>