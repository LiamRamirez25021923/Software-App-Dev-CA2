<%- include('partials/header') %>
<%- include('partials/nav') %>
    <main class="contact-page">
      <section class="hero contact-hero">
        <h1>Contact SavePoint</h1>
        <p>
          Need help, want to share feedback, or have a question about SavePoint?
          Reach out to us and we'll be happy to assist.
        </p>
      </section>

      <section class="contact-grid">
        <article class="contact-card">
          <h2>Get in touch</h2>
          <ul class="contact-list">
            <li><strong>Email:</strong> support@savepoint.com</li>
            <li><strong>Phone:</strong> +60 12 345 6789</li>
            <li><strong>Address:</strong> 88 Jalan Merdeka, Kuala Lumpur</li>
            <li><strong>Hours:</strong> Monday to Friday, 9:00 AM – 6:00 PM</li>
          </ul>
        </article>

        <article class="contact-card">
          <h2>Send us a message</h2>
          <form class="contact-form">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" placeholder="Your name" required />

            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="Your email" required />

            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="How can we help?" required></textarea>

            <button class="primary-button" type="submit">Send Message</button>
          </form>
        </article>
      </section>
    </main>
<%- include('partials/footer') %>
