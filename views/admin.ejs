<%- include('partials/header') %><%- include('partials/nav') %><main class="content-section page-top"><p class="eyebrow">ADMIN ACCESS</p><h1>SavePoint Control Room</h1><section class="admin-section pixel-panel"><h2>Users</h2><div class="table-wrap"><table><tr><th>Username</th><th>Display name</th><th>Role</th></tr><% users.forEach(u=>{ %><tr><td><%= u.username %></td><td><%= u.display_name || u.username %></td><td><%= u.role %></td></tr><% }) %></table></div></section><section class="admin-section pixel-panel"><h2>Add Marketplace Product</h2><form class="stack-form admin-product-form" action="/admin/products" method="POST" enctype="multipart/form-data"><label>Product title<input name="title" maxlength="150" required></label><label>Description<textarea name="description" rows="3"></textarea></label><div class="form-grid"><label>Category<input name="category" placeholder="Game, Hardware, Collectible" required></label><label>Platform<input name="platform" placeholder="SNES, PlayStation, Arcade"></label><label>Price ($)<input type="number" name="price" min="0.01" step="0.01" required></label><label>Quantity<input type="number" name="quantity" min="0" step="1" required></label></div><label>Product image<input type="file" name="image" accept="image/*"></label><p class="security-note">Upload a JPG, PNG, GIF or WebP image up to 5 MB.</p><button class="primary-button">Add product</button></form></section><section class="admin-section pixel-panel"><h2>Marketplace moderation</h2><% products.forEach(p=>{ %><div class="moderation-row"><span><strong><%= p.title %></strong> · <%= p.status %></span><% if(p.status!=='removed'){ %><form action="/admin/products/<%= p.id %>/delete" method="POST"><button class="danger-button">Remove</button></form><% } %></div><% }) %></section><section class="admin-section pixel-panel"><h2>Forum moderation</h2><% posts.forEach(p=>{ %><div class="moderation-row"><span><strong><%= p.title %></strong> · <%= p.status %></span><% if(p.status!=='removed'){ %><form action="/admin/posts/<%= p.id %>/delete" method="POST"><button class="danger-button">Remove</button></form><% } %></div><% }) %></section></main><%- include('partials/footer') %>