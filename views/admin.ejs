<%- include('partials/header') %><%- include('partials/nav') %><main class="content-section page-top"><p class="eyebrow">ADMIN ACCESS</p><h1>SavePoint Control Room</h1><section class="admin-section pixel-panel"><h2>Users</h2><div class="table-wrap"><table><tr><th>Username</th><th>Display name</th><th>Role</th></tr><% users.forEach(u=>{ %><tr><td><%= u.username %></td><td><%= u.display_name || u.username %></td><td><%= u.role %></td></tr><% }) %></table></div></section><section class="admin-section pixel-panel"><h2>Marketplace management</h2><p>Create, edit and remove listings directly from the Marketplace page.</p><a class="primary-button" href="/marketplace">Manage marketplace</a></section><section class="admin-section pixel-panel"><h2>Forum moderation</h2><% posts.forEach(p=>{ %><div class="moderation-row"><span><strong><%= p.title %></strong> · <%= p.status %></span><% if(p.status!=='removed'){ %><form action="/admin/posts/<%= p.id %>/delete" method="POST"><button class="danger-button">Remove</button></form><% } %></div><% }) %></section></main><%- include('partials/footer') %>