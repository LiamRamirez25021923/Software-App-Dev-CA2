<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin – bouTime</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="mb-0">Admin Panel</h1>
        <p class="text-muted mb-0">Manage all bouTime products</p>
      </div>
      <a href="/admin/add" class="btn btn-success">+ Add Product</a>
    </div>

    <table class="table table-bordered table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Image</th>
          <th>Name</th>
          <th>Category</th>
          <th>Price</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(product => { %>
          <tr>
            <td><%= product.id %></td>
            <td>
              <img src="/images/<%= product.image %>" style="width:60px; height:60px; object-fit:cover;" class="rounded">
            </td>
            <td><%= product.name %></td>
            <td>
              <span class="badge <%= product.category === 'gloves' ? 'bg-primary' : 'bg-info text-dark' %>">
                <%= product.category.charAt(0).toUpperCase() + product.category.slice(1) %>
              </span>
            </td>
            <td>$<%= product.price.toFixed(2) %></td>
            <td>
              <a href="/admin/edit/<%= product.id %>" class="btn btn-sm btn-warning me-1">Edit</a>
              <form action="/admin/delete/<%= product.id %>" method="POST" class="d-inline"
                    onsubmit="return confirm('Delete <%= product.name %>?')">
                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <%- include('partials/footer') %>
</body>
</html>