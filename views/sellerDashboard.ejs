<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seller Dashboard – bouTime</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="mb-1">Your Listings</h1>
        <p class="text-muted">Manage items you're selling on bouTime</p>
      </div>
      <a href="/seller/create" class="btn btn-lg fw-semibold" style="background-color: #ffb300; color: #242e57;">+ Create New Listing</a>
    </div>

    <% if (listings.length === 0) { %>
      <div class="alert alert-info">
        <p>You haven't created any listings yet. <a href="/seller/create" class="alert-link">Create your first listing!</a></p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table" style="border-top: 3px solid #ffb300;">
          <thead style="background-color: #f8f9fa;">
            <tr>
              <th>Title</th>
              <th>Category</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% listings.forEach(listing => { %>
              <tr>
                <td>
                  <strong><%= listing.name %></strong>
                </td>
                <td>
                  <span class="badge bg-secondary" style="background-color: #242e57 !important; color: #ffb300 !important;">
                    <%= listing.category.charAt(0).toUpperCase() + listing.category.slice(1) %>
                  </span>
                </td>
                <td style="color: #ffb300; font-weight: 600;">$<%= listing.price.toFixed(2) %></td>
                <td><%= listing.stock %> in stock</td>
                <td style="font-size: 0.9rem; color: #666;">
                  <%= new Date(listing.createdAt).toLocaleDateString() %>
                </td>
                <td>
                  <a href="/seller/edit/<%= listing.id %>" class="btn btn-sm btn-outline-secondary me-2">Edit</a>
                  <form action="/seller/delete/<%= listing.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this listing?')">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
