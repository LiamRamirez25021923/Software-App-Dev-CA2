<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit Boxer Profile</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container py-4">
    <div class="card p-4">
      <h3 class="mb-3">Edit Boxer Profile</h3>
      <form action="/profile" method="POST">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Age</label>
            <input type="number" name="age" class="form-control" value="<%= profile?profile.age:'' %>">
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Country</label>
            <input type="text" name="country" class="form-control" value="<%= profile?profile.country:'' %>">
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Weight</label>
            <div class="input-group">
              <input type="number" step="0.1" name="weight" class="form-control" value="<%= profile?profile.weightKg:'' %>">
              <select name="weightUnit" class="form-select" style="max-width:110px;">
                <option value="kg">kg</option>
                <option value="lb">lb</option>
              </select>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Height</label>
            <div class="d-flex gap-2">
              <input type="number" name="height" class="form-control" placeholder="cm" value="<%= profile?profile.heightCm:'' %>">
              <div style="min-width:12px;">or</div>
              <input type="number" name="heightFeet" class="form-control" placeholder="ft" value="<%= profile?profile.heightFeet:'' %>">
              <input type="number" name="heightInches" class="form-control" placeholder="in" value="<%= profile?profile.heightInches:'' %>">
              <input type="hidden" name="heightUnit" value="cm">
            </div>
          </div>

          <div class="col-12 mb-3">
            <label class="form-label">Training at a Gym?</label>
            <div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="gymActive" id="gymYesE" value="yes" <%= profile && profile.gym && profile.gym.active? 'checked':'' %>>
                <label class="form-check-label" for="gymYesE">Yes</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="gymActive" id="gymNoE" value="no" <%= profile && profile.gym && profile.gym.active? '':'checked' %>>
                <label class="form-check-label" for="gymNoE">No</label>
              </div>
            </div>
            <input type="text" name="gymName" class="form-control mt-2" placeholder="Gym name" value="<%= profile && profile.gym?profile.gym.name:'' %>">
          </div>

          <div class="col-12 mb-3">
            <label class="form-label">Favorite Boxers (one per line, max 10)</label>
            <textarea name="favoriteBoxers" class="form-control" rows="4"><%= profile && profile.favoriteBoxers? profile.favoriteBoxers.join('\n') : '' %></textarea>
          </div>

          <div class="col-12 mb-3">
            <label class="form-label">Preferred Styles (pick up to 3)</label>
            <select name="preferredStyles" class="form-select" multiple>
              <% styles.forEach(function(s){ %>
                <option <%= profile && profile.preferredStyles && profile.preferredStyles.indexOf(s)!==-1? 'selected':'' %>><%= s %></option>
              <% }) %>
            </select>
          </div>

        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-primary">Save Profile</button>
          <a href="/profile" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <script>
    const heightInput = document.querySelector('input[name="height"]');
    const heightFeet = document.querySelector('input[name="heightFeet"]');
    const heightInches = document.querySelector('input[name="heightInches"]');
    const heightUnitHidden = document.querySelector('input[name="heightUnit"]');
    function updateHeightUnit() {
      if ((heightFeet && heightFeet.value) || (heightInches && heightInches.value)) {
        heightUnitHidden.value = 'ft';
      } else {
        heightUnitHidden.value = 'cm';
      }
    }
    if (heightInput) heightInput.addEventListener('input', updateHeightUnit);
    if (heightFeet) heightFeet.addEventListener('input', updateHeightUnit);
    if (heightInches) heightInches.addEventListener('input', updateHeightUnit);
  </script>
</body>
</html>
