<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to bouTime</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      min-height: 100vh;
      margin: 0;
      background: linear-gradient(180deg, rgba(16, 18, 31, 0.75), rgba(16, 18, 31, 0.90)),
        url('/images/RyanGarcia.jpg') center/cover no-repeat fixed;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .auth-shell {
      min-height: 100vh;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .login-card {
      width: 100%;
      max-width: 500px;
      border-radius: 24px;
      background: rgba(7, 11, 27, 0.76);
      border: 1px solid rgba(255, 255, 255, 0.18);
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(16px);
    }

    .login-heading {
      font-family: 'Forum', serif;
      color: #ffb300;
      letter-spacing: 0.04em;
    }

    .toggle-btn {
      flex: 1;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.28);
      background: rgba(255, 255, 255, 0.08);
      color: rgba(255, 255, 255, 0.85);
      transition: all 0.2s ease;
      padding: 0.8rem 1rem;
      font-weight: 600;
    }

    .toggle-btn.active {
      background: #ffb300;
      color: #242e57;
      border-color: #ffb300;
    }

    .form-control,
    .form-select {
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: #fff;
    }

    .form-control:focus,
    .form-select:focus {
      background: rgba(255, 255, 255, 0.18);
      border-color: #ffb300;
      box-shadow: 0 0 0 0.2rem rgba(255, 179, 0, 0.18);
      color: #fff;
    }

    label {
      color: rgba(255, 255, 255, 0.82);
    }

    .small-optional {
      color: rgba(255, 255, 255, 0.64);
    }

    .alert {
      border-radius: 18px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.12);
      color: #ffffff;
    }
  </style>
</head>
<body>
  <div class="container auth-shell">
    <div class="login-card p-4 p-md-5">
      <div class="text-center mb-4">
        <h1 class="login-heading mb-2">bouTime</h1>
        <p class="text-white-50 mb-0">Choose whether to log in or create a new account.</p>
        <p class="text-white-50 mb-0">---------------------------------</p>
        <p class="text-white-50 mb-0">(ADMIN CREDENTIALS FOR CA1 USE)</p>
        <p class="text-white-50 mb-0">admin username: bouTime.</p>
        <p class="text-white-50 mb-0">admin password: pull_counter1-2.</p>
      </div>

      <% const activeForm = formMode === 'signup' ? 'signup' : 'login'; %>
      <div class="d-flex gap-2 mb-4">
        <button type="button" id="showLogin" class="toggle-btn <%= activeForm === 'login' ? 'active' : '' %>">Log In</button>
        <button type="button" id="showSignup" class="toggle-btn <%= activeForm === 'signup' ? 'active' : '' %>">Sign Up</button>
      </div>

      <% if (message) { %>
        <div class="alert alert-success mb-3"><%= message %></div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-danger mb-3"><%= error %></div>
      <% } %>

      <div id="loginSection" class="<%= activeForm !== 'login' ? 'd-none' : '' %>">
        <form action="/login" method="POST">
          <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" name="username" class="form-control" required autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-primary w-100">Log In</button>
        </form>
      </div>

      <div id="signupSection" class="<%= activeForm !== 'signup' ? 'd-none' : '' %>">
        <form action="/signup" method="POST">
          <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" name="username" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Full name <span class="small-optional">(optional)</span></label>
            <input type="text" name="fullName" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Email <span class="small-optional">(optional)</span></label>
            <input type="email" name="email" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Create a Boxer Profile?</label>
            <div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="createProfile" id="createYes" value="yes">
                <label class="form-check-label small-optional" for="createYes">Yes</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="createProfile" id="createNo" value="no" checked>
                <label class="form-check-label small-optional" for="createNo">No</label>
              </div>
            </div>
          </div>

          <div id="profileFields" class="d-none">
            <hr class="text-white-25">
            <div class="mb-2">
              <label class="form-label">Age</label>
              <input type="number" name="age" class="form-control" min="1">
            </div>
            <div class="mb-2">
              <label class="form-label">Weight</label>
              <div class="input-group">
                <input type="number" step="0.1" name="weight" class="form-control">
                <select name="weightUnit" class="form-select" style="max-width:110px;">
                  <option value="kg">kg</option>
                  <option value="lb">lb</option>
                </select>
              </div>
              <small>We will show both kg and lb automatically.</small>
            </div>
            <div class="mb-2">
              <label class="form-label">Height</label>
              <div class="d-flex gap-2">
                <input type="number" name="height" class="form-control" placeholder="cm">
                <div style="min-width:12px;">or</div>
                <input type="number" name="heightFeet" class="form-control" placeholder="ft">
                <input type="number" name="heightInches" class="form-control" placeholder="in">
                <input type="hidden" name="heightUnit" value="cm">
              </div>
              <small>Enter either cm or ft/in.</small>
            </div>
            <div class="mb-2">
              <label class="form-label">Country</label>
              <input type="text" name="country" class="form-control">
            </div>
            <div class="mb-2">
              <label class="form-label">Training at a Gym?</label>
              <div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="gymActive" id="gymYes" value="yes">
                  <label class="form-check-label small-optional" for="gymYes">Yes</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="gymActive" id="gymNo" value="no" checked>
                  <label class="form-check-label small-optional" for="gymNo">No</label>
                </div>
              </div>
              <input type="text" name="gymName" class="form-control mt-2" placeholder="Gym name (if applicable)">
            </div>
            <div class="mb-2">
              <label class="form-label">Favorite Boxers (one per line, max 10)</label>
              <textarea name="favoriteBoxers" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-2">
              <label class="form-label">Favorite Style</label>
              <select name="preferredStyles" class="form-select" multiple>
                <option>Swarmer</option>
                <option>Out-Boxer</option>
                <option>Slugger</option>
                <option>Boxer-Puncher</option>
                <option>Counterpuncher</option>
                <option>Southpaw</option>
                <option>Switch-Hitter</option>
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    const showLogin = document.getElementById('showLogin');
    const showSignup = document.getElementById('showSignup');
    const loginSection = document.getElementById('loginSection');
    const signupSection = document.getElementById('signupSection');

    showLogin.addEventListener('click', () => {
      showLogin.classList.add('active');
      showSignup.classList.remove('active');
      loginSection.classList.remove('d-none');
      signupSection.classList.add('d-none');
    });

    showSignup.addEventListener('click', () => {
      showSignup.classList.add('active');
      showLogin.classList.remove('active');
      signupSection.classList.remove('d-none');
      loginSection.classList.add('d-none');
    });

    // Profile fields toggle on signup
    const createYes = document.getElementById('createYes');
    const createNo = document.getElementById('createNo');
    const profileFields = document.getElementById('profileFields');
    if (createYes && createNo && profileFields) {
      function toggleProfileFields() {
        if (createYes.checked) profileFields.classList.remove('d-none');
        else profileFields.classList.add('d-none');
      }
      createYes.addEventListener('change', toggleProfileFields);
      createNo.addEventListener('change', toggleProfileFields);
      toggleProfileFields();
    }

    // Ensure heightUnit hidden input is set depending on which height fields are used
    const heightInput = document.querySelector('input[name="height"]');
    const heightFeet = document.querySelector('input[name="heightFeet"]');
    const heightInches = document.querySelector('input[name="heightInches"]');
    const heightUnitHidden = document.querySelector('input[name="heightUnit"]');
    function updateHeightUnit() {
      if ((heightFeet && heightFeet.value) || (heightInches && heightInches.value)) {
        heightUnitHidden.value = 'ft';
      } else {
        heightUnitHidden.value = 'cm';
      }
    }
    if (heightInput) heightInput.addEventListener('input', updateHeightUnit);
    if (heightFeet) heightFeet.addEventListener('input', updateHeightUnit);
    if (heightInches) heightInches.addEventListener('input', updateHeightUnit);
  </script>
</body>
</html>
