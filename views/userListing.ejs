<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= listing.name %> – bouTime</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <div class="row g-5 align-items-center">

      <div class="col-md-6">
        <img src="/images/<%= listing.image %>" class="img-fluid rounded shadow" alt="<%= listing.name %>">
      </div>

      <div class="col-md-6">
        <span class="badge bg-secondary mb-2"><%= listing.category.charAt(0).toUpperCase() + listing.category.slice(1) %></span>
        <span class="badge bg-warning text-dark mb-2">Marketplace</span>
        <h1 class="mb-2"><%= listing.name %></h1>
        <p class="text-success fw-bold fs-3">$<%= listing.price.toFixed(2) %></p>
        <p class="text-muted mb-3"><%= listing.description %></p>

        <p class="mb-2"><strong>Seller:</strong> <%= listing.seller %></p>
        <p class="mb-4"><strong>Stock:</strong> <%= listing.stock %> available</p>

        <ul class="list-group list-group-flush mb-4">
          <% listing.features.forEach(feature => { %>
            <li class="list-group-item"><%= feature %></li>
          <% }) %>
        </ul>

        <% if (listing.sizes && listing.sizes.length) { %>
          <div class="mb-3">
            <label for="sizeSelect" class="form-label fw-semibold">Size / Type</label>
            <select class="form-select" id="sizeSelect" name="size" style="width:150px">
              <% listing.sizes.forEach(type => { %>
                <option><%= type %></option>
              <% }) %>
            </select>
          </div>
        <% } %>

        <div class="mb-3">
          <label for="quantityInput" class="form-label fw-semibold">Quantity</label>
          <input type="number" class="form-control" id="quantityInput" name="quantity" value="1" min="1" style="width:100px">
        </div>

        <form action="/cart/add/<%= listing.id %>" method="POST" class="d-flex gap-2">
          <input type="hidden" name="size" id="formSize" value="">
          <input type="hidden" name="quantity" id="formQuantity" value="1">
          <input type="hidden" name="redirect" value="/listing/<%= listing.id %>">
          <button type="submit" class="btn btn-lg" style="background-color: #ffb300; color: #242e57; font-weight: 700;" <%= listing.stock === 0 ? 'disabled' : '' %>>
            <%= listing.stock === 0 ? 'Out of Stock' : '🛒 Add to Cart' %>
          </button>
          <a href="/<%= listing.category %>" class="btn btn-outline-secondary btn-lg">← Back</a>
        </form>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    const sizeSelect = document.getElementById('sizeSelect');
    const quantityInput = document.getElementById('quantityInput');
    const formSize = document.getElementById('formSize');
    const formQuantity = document.getElementById('formQuantity');
    const form = document.querySelector('form');

    function updateFormValues() {
      if (formSize) {
        formSize.value = sizeSelect ? sizeSelect.value : '';
      }
      if (formQuantity) {
        formQuantity.value = quantityInput.value;
      }
    }

    if (sizeSelect) {
      sizeSelect.addEventListener('change', updateFormValues);
    }
    quantityInput.addEventListener('change', updateFormValues);

    updateFormValues();
    if (form) {
      form.addEventListener('submit', updateFormValues);
    }
  </script>
</body>
</html>