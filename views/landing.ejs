<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>bouTime – The All-In-One Boxing Platform</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .hero-section {
      background: linear-gradient(135deg, #242e57 0%, #1a1f3a 100%);
      color: #ffb300;
      padding: 80px 20px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .hero-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="rgba(255,179,0,0.1)"/><circle cx="80" cy="80" r="2" fill="rgba(255,179,0,0.1)"/><circle cx="80" cy="20" r="2" fill="rgba(255,179,0,0.1)"/><circle cx="20" cy="80" r="2" fill="rgba(255,179,0,0.1)"/></svg>');
      opacity: 0.3;
    }

    .hero-content {
      position: relative;
      z-index: 1;
    }

    .hero-section h1 {
      font-size: 3.5rem;
      font-weight: 900;
      margin-bottom: 20px;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    .hero-section p {
      font-size: 1.3rem;
      margin-bottom: 30px;
      color: #ffffff;
    }

    .feature-card {
      background: white;
      border-radius: 12px;
      padding: 40px 30px;
      text-align: center;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .feature-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 8px 25px rgba(36, 46, 87, 0.2);
    }

    .feature-icon {
      font-size: 3.5rem;
      margin-bottom: 15px;
      display: inline-block;
    }

    .feature-card h3 {
      color: #242e57;
      font-weight: 700;
      margin-bottom: 15px;
      font-size: 1.5rem;
    }

    .feature-card p {
      color: #666;
      margin-bottom: 25px;
      font-size: 1rem;
      line-height: 1.6;
    }

    .feature-btn {
      background-color: #ffb300;
      color: #242e57;
      border: none;
      border-radius: 6px;
      padding: 12px 30px;
      font-weight: 600;
      transition: background-color 0.3s ease;
      display: inline-block;
      text-decoration: none;
      cursor: pointer;
    }

    .feature-btn:hover {
      background-color: #ffc533;
      color: #242e57;
      text-decoration: none;
    }

    .features-section {
      padding: 60px 20px;
      background-color: #f8f9fa;
    }

    .section-title {
      text-align: center;
      color: #242e57;
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 50px;
    }

    .tagline {
      text-align: center;
      font-size: 1.2rem;
      color: #666;
      margin-bottom: 60px;
    }

    .cta-section {
      background: linear-gradient(135deg, #242e57 0%, #1a1f3a 100%);
      color: white;
      padding: 60px 20px;
      text-align: center;
    }

    .cta-section h2 {
      color: #ffb300;
      font-size: 2rem;
      margin-bottom: 30px;
    }

    .cta-btn {
      background-color: #ffb300;
      color: #242e57;
      border: none;
      padding: 15px 40px;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 6px;
      cursor: pointer;
      transition: background-color 0.3s ease;
      text-decoration: none;
      display: inline-block;
      margin: 10px;
    }

    .cta-btn:hover {
      background-color: #ffc533;
      color: #242e57;
      text-decoration: none;
    }

    .secondary-btn {
      border: 2px solid #ffb300;
      background-color: transparent;
      color: #ffb300;
    }

    .secondary-btn:hover {
      background-color: #ffb300;
      color: #242e57;
    }

    @media (max-width: 768px) {
      .hero-section h1 {
        font-size: 2rem;
      }

      .hero-section p {
        font-size: 1rem;
      }

      .section-title {
        font-size: 1.8rem;
      }
    }
  </style>
</head>
<body>

  <%- include('partials/navbar') %>

  <!-- Hero Section -->
  <div class="hero-section">
    <div class="hero-content">
      <h1>bouTime</h1>
      <p>The All-In-One Boxing Platform</p>
      <p style="font-size: 1rem; color: #ffffff; margin-bottom: 40px;">Shop premium gear, connect with the community, and watch the fights you love</p>
    </div>
  </div>

  <!-- Features Section -->
  <div class="features-section">
    <div class="container">
      <h2 class="section-title">What Can You Do?</h2>
      <p class="tagline">Whether you're a casual fan or a dedicated boxing enthusiast, bouTime has something for everyone</p>

      <div class="row g-4">
        <!-- E-commerce Feature -->
        <div class="col-lg-4 col-md-6">
          <div class="feature-card">
            <div>
              <div class="feature-icon">🛍️</div>
              <h3>Shop Premium Gear</h3>
              <p>Browse and buy top-quality boxing equipment from leading brands. Find everything from gloves to headgear, shoes to hand wraps. Get the gear that champions use.</p>
            </div>
            <a href="/shop" class="feature-btn">Shop Now</a>
          </div>
        </div>

        <!-- Forum Feature -->
        <div class="col-lg-4 col-md-6">
          <div class="feature-card">
            <div>
              <div class="feature-icon">💬</div>
              <h3>Community Forum</h3>
              <p>Join discussions with fellow boxing fans and fighters. Share your thoughts, post fight highlights, exchange training tips, and engage with the community. It's like a subreddit for boxing.</p>
            </div>
            <a href="/forum" class="feature-btn">Join Forum</a>
          </div>
        </div>

        <!-- Explore Fights Feature -->
        <div class="col-lg-4 col-md-6">
          <div class="feature-card">
            <div>
              <div class="feature-icon">🥊</div>
              <h3>Explore Fights</h3>
              <p>Discover and watch fights tailored to your interests. Based on your favorite boxers, we recommend matches and highlights. Never miss a fight you care about.</p>
            </div>
            <a href="/explore" class="feature-btn">Explore</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="cta-section">
    <h2>Ready to Enter the Ring?</h2>
    <p style="font-size: 1.1rem; margin-bottom: 30px;">Start shopping, discussing, and exploring the boxing world with bouTime today</p>
    <a href="/shop" class="cta-btn">Browse Shop</a>
    <a href="/forum" class="cta-btn secondary-btn">Visit Forum</a>
  </div>

  <%- include('partials/footer') %>

</body>
</html>
