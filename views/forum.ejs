<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Community Forum - bouTime</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <link rel="stylesheet" href="/css/style.css">

  <style>
    body {
      background: #dae0e6;
    }

    .reddit-layout {
      max-width: 1300px;
      margin: auto;
      padding: 20px;
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 20px;
    }

    .post-card {
      background: white;
      border-radius: 8px;
      overflow: hidden;
      display: flex;
      margin-bottom: 16px;
      border: 1px solid #ccc;
      transition: 0.2s;
    }

    .post-card:hover {
      border-color: #878a8c;
    }

    .vote-column {
      width: 60px;
      background: #f8f9fa;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 12px;
      font-weight: bold;
    }

    .vote-btn {
      border: none;
      background: transparent;
      font-size: 20px;
      cursor: pointer;
      padding: 2px 6px;
      border-radius: 4px;
      line-height: 1;
    }

    .vote-btn:hover {
      background: #e8e8e8;
    }

    .vote-btn.upvoted {
      color: #ff4500;
    }

    .vote-btn.downvoted {
      color: #7193ff;
    }

    .vote-count {
      font-size: 14px;
      margin: 2px 0;
    }

    .post-content {
      flex: 1;
      padding: 16px;
    }

    .post-meta {
      font-size: 13px;
      color: #777;
      margin-bottom: 8px;
    }

    .post-title {
      font-size: 22px;
      font-weight: 700;
      color: black;
      text-decoration: none;
    }

    .post-title:hover {
      color: #ff4500;
    }

    .post-image {
      width: 100%;
      border-radius: 8px;
      margin-top: 12px;
      max-height: 500px;
      object-fit: cover;
    }

    .sidebar-card {
      background: white;
      border-radius: 8px;
      padding: 20px;
      border: 1px solid #ccc;
      position: sticky;
      top: 20px;
    }

    .create-btn {
      width: 100%;
      background: #ff4500;
      border: none;
      color: white;
      font-weight: 700;
      padding: 12px;
      border-radius: 999px;
      margin-top: 12px;
    }

    .sort-bar {
      background: white;
      border-radius: 8px;
      padding: 12px 16px;
      margin-bottom: 20px;
      border: 1px solid #ccc;
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .sort-pill {
      padding: 8px 16px;
      border-radius: 999px;
      text-decoration: none;
      color: black;
      background: #f0f2f5;
      font-weight: 600;
    }

    .sort-pill.active {
      background: #ff4500;
      color: white;
    }
  </style>
</head>
<body>

<%- include('partials/navbar') %>

<div class="reddit-layout">

  <div>

    <div class="sort-bar">
      <strong>Sort By:</strong>

      <a href="/forum?sort=recency"
         class="sort-pill <%= sort === 'recency' || sort === 'recent' ? 'active' : '' %>">
         Recent
      </a>

      <a href="/forum?sort=upvotes"
         class="sort-pill <%= sort === 'upvotes' || sort === 'top' ? 'active' : '' %>">
         Top
      </a>

      <a href="/forum?sort=comments"
         class="sort-pill <%= sort === 'comments' ? 'active' : '' %>">
         Most Comments
      </a>
    </div>

    <% if (posts.length === 0) { %>
      <div class="alert alert-light border">
        No posts yet. Be the first to post.
      </div>
    <% } %>

    <% posts.forEach(post => { %>

      <div class="post-card">

        <div class="vote-column">
          <button class="vote-btn <%= post.userVote === 'upvote' ? 'upvoted' : '' %>"
                  onclick="vote(<%= post.id %>, 'upvote', this)"
                  <%= !user ? 'disabled title="Login to vote"' : '' %>>&#9650;</button>
          <div class="vote-count" id="post-votes-<%= post.id %>"><%= post.netVotes || 0 %></div>
          <button class="vote-btn <%= post.userVote === 'downvote' ? 'downvoted' : '' %>"
                  onclick="vote(<%= post.id %>, 'downvote', this)"
                  <%= !user ? 'disabled title="Login to vote"' : '' %>>&#9660;</button>
        </div>

        <div class="post-content">

          <div class="post-meta">
            Posted by u/<%= post.author %>
            &bull;
            <%= new Date(post.createdAt).toLocaleString() %>
          </div>

          <a href="/forum/posts/<%= post.id %>" class="post-title">
            <%= post.title %>
          </a>

          <p class="mt-3"><%= post.description %></p>

          <% if(post.image){ %>
            <img src="/images/<%= post.image %>" class="post-image">
          <% } %>

          <div class="mt-3 text-muted">
            &#128172; <%= post.commentCount || 0 %> comments
          </div>

        </div>
      </div>

    <% }) %>

  </div>

  <div>

    <div class="sidebar-card">

      <h4>&#129354; bouTime Community</h4>

      <p>
        Talk boxing, training, gear, sparring, fighters,
        techniques and everything combat sports.
      </p>

      <% if(user){ %>
        <a href="/forum/new">
          <button class="create-btn">Create Post</button>
        </a>
      <% } else { %>
        <a href="/login">
          <button class="create-btn">Login to Post</button>
        </a>
      <% } %>

    </div>

  </div>

</div>

<script>
async function vote(postId, direction, btn) {
  const parent = btn.parentElement;
  const upBtn = parent.querySelector('.vote-btn:first-child');
  const downBtn = parent.querySelector('.vote-btn:last-child');
  const isUpvoted = upBtn.classList.contains('upvoted');
  const isDownvoted = downBtn.classList.contains('downvoted');

  let voteType;
  if (direction === 'upvote') {
    voteType = isUpvoted ? 'remove' : 'upvote';
  } else {
    voteType = isDownvoted ? 'remove' : 'downvote';
  }

  try {
    const res = await fetch('/forum/posts/' + postId + '/vote', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ voteType })
    });
    const data = await res.json();
    if (data.success) {
      document.getElementById('post-votes-' + postId).textContent = data.netVotes;
      upBtn.classList.toggle('upvoted', data.userVote === 'upvote');
      downBtn.classList.toggle('downvoted', data.userVote === 'downvote');
    }
  } catch (e) {
    console.error('Vote failed', e);
  }
}
</script>

</body>
</html>
