<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Retro Gaming Forum</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('partials/navbar') %>

<div class="reddit-layout">

  <div>
    <div class="sort-bar">
      <strong>Sort By:</strong>
      <a href="/forum?sort=recency" class="sort-pill <%= sort === 'recency' ? 'active' : '' %>">Recent</a>
      <a href="/forum?sort=upvotes" class="sort-pill <%= sort === 'upvotes' ? 'active' : '' %>">Top</a>
      <a href="/forum?sort=comments" class="sort-pill <%= sort === 'comments' ? 'active' : '' %>">Most Comments</a>
    </div>

    <% if (posts.length === 0) { %>
      <div class="alert alert-light border">No posts yet. Be the first to post.</div>
    <% } %>

    <% posts.forEach(post => { %>
      <div class="post-card">
        <div class="vote-column">
          <button class="vote-btn <%= post.userVote === 'upvote' ? 'upvoted' : '' %>" 
                  data-item-type="post" data-item-id="<%= post.id %>" data-direction="upvote"
                  <%= !user ? 'disabled' : '' %>>&#9650;</button>
          <div class="vote-count" id="post-votes-<%= post.id %>"><%= post.netVotes || 0 %></div>
          <button class="vote-btn <%= post.userVote === 'downvote' ? 'downvoted' : '' %>" 
                  data-item-type="post" data-item-id="<%= post.id %>" data-direction="downvote"
                  <%= !user ? 'disabled' : '' %>>&#9660;</button>
        </div>

        <div class="post-content">
          <div class="post-meta">
            Posted by u/<%= post.author %> • <%= new Date(post.createdAt).toLocaleString() %>
          </div>
          <a href="/forum/posts/<%= post.id %>" class="post-title"><%= post.title %></a>
          <p class="mt-3"><%= post.description %></p>
          <% if(post.image){ %><img src="/images/<%= post.image %>" class="post-image"><% } %>
          <div class="mt-3 text-muted">💬 <%= post.commentCount || 0 %> comments</div>
        </div>
      </div>
    <% }) %>
  </div>

  <div>
    <div class="sidebar-card">
      <h4>🎮 Retro Gaming Communities</h4>
      <% if(user){ %>
        <% if(user.role === 'admin'){ %>
          <a href="/communities/manage"><button class="create-btn">Manage Communities</button></a>
        <% } else { %>
          <a href="/communities/new"><button class="create-btn">Create Community</button></a>
          <a href="/communities/join"><button class="create-btn">Join Community</button></a>
        <% } %>
        <a href="/forum/new"><button class="create-btn">Create Post</button></a>
      <% } else { %>
        <a href="/login"><button class="create-btn">Login to Post</button></a>
      <% } %>
    </div>
  </div>

</div>

<script>
async function vote(itemType, itemId, direction) {
  const res = await fetch(`/forum/${itemType}s/${itemId}/vote`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ voteType: direction })
  });
  const data = await res.json();
  if (data.success) {
    const voteCount = document.getElementById(`${itemType}-votes-${itemId}`);
    if (voteCount) voteCount.textContent = data.netVotes;
  }
}

window.addEventListener('click', (event) => {
  const button = event.target.closest('button[data-item-type][data-item-id][data-direction]');
  if (!button) return;
  const itemType = button.dataset.itemType;
  const itemId = button.dataset.itemId;
  const direction = button.dataset.direction;
  if (!itemType || !itemId || !direction) return;
  event.preventDefault();
  vote(itemType, itemId, direction);
});
</script>

</body>
</html>
