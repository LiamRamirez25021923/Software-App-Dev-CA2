<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Boxer Profile</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container py-4">
    <div class="card p-4">
      <div class="d-flex justify-content-between align-items-start mb-3">
        <h3>Boxer Profile</h3>
        <div>
          <a href="/profile/edit" class="btn btn-sm btn-primary">Edit Profile</a>
        </div>
      </div>

      <% if (!profile) { %>
        <div class="alert alert-warning">You have not created a Boxer Profile yet. <a href="/profile/edit">Create one now</a>.</div>
      <% } else { %>
        <div class="row">
          <div class="col-md-4">
            <div style="height:240px;background-size:cover;background-position:center;border-radius:8px;"
              <% if (profile.favoriteBoxers && profile.favoriteBoxers.length>0) { %>
                data-bg="/images/placeholder_boxer.jpg"
              <% } else { %>
                data-bg="/images/placeholder_boxer.jpg"
              <% } %>
              id="profileHero"></div>
          </div>
          <div class="col-md-8">
            <dl class="row">
              <dt class="col-sm-4">Username</dt><dd class="col-sm-8"><%= user.username %></dd>
              <dt class="col-sm-4">Age</dt><dd class="col-sm-8"><%= profile.age || '—' %></dd>
              <dt class="col-sm-4">Weight</dt><dd class="col-sm-8"><%= profile.weightKg ? profile.weightKg + ' kg / ' + profile.weightLb + ' lb' : '—' %></dd>
              <dt class="col-sm-4">Height</dt><dd class="col-sm-8"><%= profile.heightCm ? profile.heightCm + ' cm / ' + (profile.heightFeet!==null? profile.heightFeet + "'" + profile.heightInches + '"' : '') : '—' %></dd>
              <dt class="col-sm-4">Country</dt><dd class="col-sm-8"><%= profile.country || '—' %></dd>
              <dt class="col-sm-4">Gym</dt><dd class="col-sm-8"><%= profile.gym && profile.gym.active ? profile.gym.name || 'Yes' : 'No' %></dd>
              <dt class="col-sm-4">Preferred Style</dt><dd class="col-sm-8"><%= (profile.preferredStyles && profile.preferredStyles.length>0)? profile.preferredStyles.join(', ') : '—' %></dd>
              <dt class="col-sm-4">Weight Class</dt><dd class="col-sm-8"><%= profile.weightClass || '—' %></dd>
            </dl>

            <h5>Favorite Boxers</h5>
            <% if (profile.favoriteBoxers && profile.favoriteBoxers.length>0) { %>
              <div class="d-flex gap-2 flex-wrap">
                <% profile.favoriteBoxers.forEach(function(b) { %>
                  <a href="/boxer/<%= encodeURIComponent(b) %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm"><%= b %></a>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-muted">You haven't added any favorite boxers yet.</p>
            <% } %>

          </div>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    // set hero background if available
    (function(){
      var hero = document.getElementById('profileHero');
      if (!hero) return;
      var bg = hero.getAttribute('data-bg') || '/images/placeholder_boxer.jpg';
      hero.style.backgroundImage = 'url(' + bg + ')';
    })();
  </script>
</body>
</html>
