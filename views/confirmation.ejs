<%- include('partials/header') %><%- include('partials/nav') %><main class="content-section page-top confirmation-wrap"><section class="confirmation-card pixel-panel"><p class="eyebrow">MISSION COMPLETE</p><h1>Purchase Confirmed!</h1><p>Your order <strong>#<%= order.id %></strong> has been saved successfully.</p><div class="confirmation-grid"><div><h2>Delivery</h2><p><%= order.customer_name %><br><%= order.customer_email %><br><%= order.delivery_address %></p></div><div><h2>Payment</h2><p>Card ending in <strong><%= order.card_last_four %></strong></p><p>Placed: <%= new Date(order.created_at).toLocaleString() %></p></div></div><h2>Purchased items</h2><% items.forEach(item=>{ %><div class="confirmation-row"><span><%= item.product_title %> × <%= item.quantity %></span><strong>$<%= Number(item.line_total).toFixed(2) %></strong></div><% }) %><div class="confirmation-total">Total: $<%= Number(order.total_price).toFixed(2) %></div><a class="primary-button" href="/marketplace">Return to marketplace</a></section></main><%- include('partials/footer') %>
