<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= listing ? 'Edit Listing' : 'Create Listing' %> – bouTime</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container mt-4">
    <div class="row justify-content-center">
      <div class="col-md-7">

        <h1 class="mb-1"><%= listing ? 'Edit Listing' : 'Create a New Listing' %></h1>
        <p class="text-muted mb-4">Fill in the details below to <%= listing ? 'update your' : 'create a new' %> item for sale.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="<%= listing ? '/seller/edit/' + listing.id : '/seller/create' %>" method="POST" enctype="multipart/form-data">

          <div class="mb-3">
            <label class="form-label fw-semibold">Item Title *</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Barely used Hayabusa gloves" value="<%= listing ? listing.name : '' %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Category *</label>
            <select name="category" class="form-select" required>
              <option value="">-- Select --</option>
              <option value="gloves" <%= listing && listing.category === 'gloves' ? 'selected' : '' %>>Gloves</option>
              <option value="shoes" <%= listing && listing.category === 'shoes' ? 'selected' : '' %>>Shoes</option>
              <option value="headgear" <%= listing && listing.category === 'headgear' ? 'selected' : '' %>>Headgear</option>
              <option value="groinwear" <%= listing && listing.category === 'groinwear' ? 'selected' : '' %>>Groinwear</option>
              <option value="handwraps" <%= listing && listing.category === 'handwraps' ? 'selected' : '' %>>Handwraps</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Price (USD) *</label>
            <input type="number" name="price" class="form-control" placeholder="e.g. 50.00" step="0.01" min="0" value="<%= listing ? listing.price : '' %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Number in Stock *</label>
            <input type="number" name="stock" class="form-control" placeholder="e.g. 5" min="1" value="<%= listing ? listing.stock : '' %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Photo</label>
            <% if (listing && listing.image) { %>
              <div class="mb-2">
                <img src="/images/<%= listing.image %>" style="height:100px; object-fit:contain;" class="rounded border">
                <p class="form-text">Current photo. Upload a new one below to replace it.</p>
              </div>
            <% } %>
            <input type="file" name="image" class="form-control" accept="image/*">
            <input type="hidden" name="existingImage" value="<%= listing ? listing.image : '' %>">
            <div class="form-text">Accepted formats: JPG, PNG, WEBP.</div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Description *</label>
            <textarea name="description" class="form-control" rows="4" placeholder="Describe your item: condition, brand, features, why you're selling..." required><%= listing ? listing.description : '' %></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Item Type / Sizes</label>
            <textarea name="sizes" class="form-control" rows="3" placeholder="One size per line&#10;e.g. M&#10;L&#10;XL&#10;(Leave blank to use default sizes for category)"><%= listing && listing.sizes ? listing.sizes.join('\n') : '' %></textarea>
            <div class="form-text">Specify sizes/lengths/weights (e.g., 10 oz, S/M/L, 120 in). Leave blank for category defaults.</div>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Features</label>
            <textarea name="features" class="form-control" rows="4" placeholder="One feature per line&#10;e.g. Genuine leather&#10;Lightly used&#10;Great condition&#10;(Optional)"><%= listing && listing.features ? listing.features.join('\n') : '' %></textarea>
            <div class="form-text">Highlight key features or selling points.</div>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success btn-lg"><%= listing ? 'Update Listing' : 'Publish Listing' %></button>
            <a href="/seller/dashboard" class="btn btn-outline-secondary btn-lg">Cancel</a>
          </div>

        </form>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>