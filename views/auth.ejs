<%- include('partials/header') %><main class="auth-page"><section class="auth-card pixel-panel"><div class="auth-copy"><p class="eyebrow">PRESS START</p><h1>SavePoint</h1><p>Your all-in-one hub for retro games, hardware, community discussions and news.</p><div class="console-art"><span>●</span><span class="screen">READY</span><span>◆</span></div></div><div class="auth-form-wrap"><div class="auth-tabs"><a class="<%= mode==='login'?'active':'' %>" href="/login">Log in</a><a class="<%= mode==='signup'?'active':'' %>" href="/signup">Sign up</a></div><% if(error){ %><div class="alert"><%= error %></div><% } %><form action="/<%= mode %>" method="POST" class="stack-form"><% if(mode==='signup'){ %><label>Display name<input name="displayName" value="<%= values.displayName||'' %>" required></label><label>Email<input type="email" name="email" value="<%= values.email||'' %>"></label><label>Bio<textarea name="bio" rows="3"><%= values.bio||'' %></textarea></label><label>Favourite console<input name="favouriteConsole" value="<%= values.favouriteConsole||'' %>" placeholder="e.g. Sega Dreamcast"></label><% } %><label>Username<input name="username" value="<%= values.username||'' %>" required></label><label>Password<input type="password" name="password" required></label><button class="primary-button"><%= mode==='signup'?'Create Save File':'Load Save File' %></button></form></div></section></main><%- include('partials/footer') %>