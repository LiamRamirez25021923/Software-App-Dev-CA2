<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create Post</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('partials/navbar') %>

<div class="create-wrapper">
  <div class="create-card">
    <h2 class="mb-4">Create a Post</h2>

    <% if(error){ %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/forum/posts" method="POST" enctype="multipart/form-data">

      <div class="mb-3">
        <label class="form-label">Title</label>
        <input type="text" class="form-control" name="title" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" rows="8" name="description" required></textarea>
      </div>

      <% if(user && user.role === 'admin'){ %>
        <!-- Admins can assign posts to communities -->
        <div class="mb-3">
          <label class="form-label">Assign to Community</label>
          <select class="form-control" name="communityId">
            <% communities.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
      <% } else if(user && user.role === 'regular'){ %>
        <!-- Regular users can only pick from communities they joined -->
        <div class="mb-3">
          <label class="form-label">Post in Community</label>
          <select class="form-control" name="communityId" required>
            <% user.communities.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
      <% } %>

      <div class="mb-3">
        <label class="form-label">Upload Image <span class="text-muted fw-normal">(optional)</span></label>
        <input type="file" class="form-control" name="image" accept="image/*">
      </div>

      <button class="btn btn-warning">Post</button>
    </form>
  </div>
</div>

</body>
</html>
