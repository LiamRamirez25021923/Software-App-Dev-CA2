<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= post.title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<%- include('partials/navbar') %>

<div class="wrapper">

  <div class="card-box">
    <div class="post-layout">
      <div class="vote-column">
        <button class="vote-btn <%= post.userVote === 'upvote' ? 'upvoted' : '' %>"
                data-item-type="post" data-item-id="<%= post.id %>" data-direction="upvote"
                <%= !user ? 'disabled' : '' %>>&#9650;</button>
        <div class="vote-count" id="post-votes-<%= post.id %>"><%= post.netVotes || 0 %></div>
        <button class="vote-btn <%= post.userVote === 'downvote' ? 'downvoted' : '' %>"
                data-item-type="post" data-item-id="<%= post.id %>" data-direction="downvote"
                <%= !user ? 'disabled' : '' %>>&#9660;</button>
      </div>

      <div class="post-body">
        <h2><%= post.title %></h2>
        <div class="text-muted mb-3">Posted by u/<%= post.author %> • <%= new Date(post.createdAt).toLocaleString() %></div>
        <p><%= post.description %></p>
        <% if(post.image){ %><img src="/images/<%= post.image %>" class="img-fluid rounded"><% } %>

        <% if(user && (user.role === 'admin' || user.username === post.author)){ %>
          <div class="mt-4 d-flex gap-2">
            <form action="/forum/posts/<%= post.id %>?_method=DELETE" method="POST">
              <button class="btn btn-danger btn-sm">Delete Post</button>
            </form>
            <% if(user.role === 'regular' && user.username === post.author){ %>
              <a href="/forum/posts/<%= post.id %>/edit" class="btn btn-secondary btn-sm">Edit Post</a>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <% if(user){ %>
    <div class="card-box">
      <h4>Leave a Comment</h4>
      <form action="/forum/posts/<%= post.id %>/comments" method="POST" enctype="multipart/form-data">
        <textarea class="form-control mb-3" rows="4" name="text" placeholder="Your thoughts..." required></textarea>
        <input type="file" class="form-control mb-3" name="image" accept="image/*">
        <button class="btn btn-warning">Comment</button>
      </form>
    </div>
  <% } %>

  <div class="card-box">
    <h4>Comments (<%= comments.length %>)</h4>
    <% if(comments.length === 0){ %><p>No comments yet.</p><% } %>
    <% comments.forEach(comment => { %>
      <div class="comment-box">
        <div class="comment-layout">
          <div class="comment-vote-column">
            <button class="vote-btn <%= comment.userVote === 'upvote' ? 'upvoted' : '' %>"
                    data-item-type="comment" data-item-id="<%= comment.id %>" data-direction="upvote"
                    <%= !user ? 'disabled' : '' %>>&#9650;</button>
            <div class="vote-count" id="comment-votes-<%= comment.id %>"><%= comment.netVotes || 0 %></div>
            <button class="vote-btn <%= comment.userVote === 'downvote' ? 'downvoted' : '' %>"
                    data-item-type="comment" data-item-id="<%= comment.id %>" data-direction="downvote"
                    <%= !user ? 'disabled' : '' %>>&#9660;</button>
          </div>
          <div class="comment-body">
            <div class="fw-bold">u/<%= comment.author %></div>
            <div class="text-muted small mb-2"><%= new Date(comment.createdAt).toLocaleString() %></div>
            <p><%= comment.text %></p>
            <% if(comment.image){ %><img src="/images/<%= comment.image %>" class="comment-image"><% } %>

            <% if(user && (user.role === 'admin' || user.username === comment.author)){ %>
              <div class="mt-2 d-flex gap-2">
                <form action="/forum/comments/<%= comment.id %>?_method=DELETE" method="POST">
                  <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
                <% if(user.role === 'regular' && user.username === comment.author){ %>
                  <a href="/forum/comments/<%= comment.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<script>
async function vote(itemType, itemId, direction, btn) {
  const res = await fetch(`/forum/${itemType}s/${itemId}/vote`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ voteType: direction })
  });
  const data = await res.json();
  if (data.success) {
    const voteCount = document.getElementById(`${itemType}-votes-${itemId}`);
    if (voteCount) voteCount.textContent = data.netVotes;
  }
}
</script>
</body>
</html>