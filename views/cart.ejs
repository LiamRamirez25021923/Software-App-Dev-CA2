<%- include('partials/header') %><%- include('partials/nav') %><main class="content-section page-top"><p class="eyebrow">INVENTORY SCREEN</p><h1>Your Cart</h1>
<% if(!items.length){ %><section class="pixel-panel empty-state"><h2>Your cart is empty</h2><p>Add something from the marketplace to continue.</p><a class="primary-button" href="/marketplace">Browse marketplace</a></section><% } else { %>
<section class="cart-layout"><div class="cart-list"><% items.forEach(item=>{ const cartImageSrc = item.image_url ? (/^(?:https?:\/\/|\/)/i.test(item.image_url) ? item.image_url : '/images/' + item.image_url) : null; %><article class="cart-item pixel-panel"><div class="cart-thumb"><% if(cartImageSrc){ %><img src="<%= cartImageSrc %>" alt="<%= item.title %>"><% } else { %>🎮<% } %></div><div><h2><%= item.title %></h2><p>$<%= Number(item.price).toFixed(2) %> each</p><strong>Quantity: <%= item.selectedQuantity %></strong></div><div class="cart-actions"><strong>$<%= item.lineTotal.toFixed(2) %></strong><form action="/cart/<%= item.id %>/decrease" method="POST"><button class="secondary-button">Reduce by 1</button></form><form action="/cart/<%= item.id %>/remove" method="POST"><button class="danger-button">Remove</button></form></div></article><% }) %></div>
<aside class="cart-summary pixel-panel"><h2>Order Summary</h2><p>Total</p><strong class="price">$<%= total.toFixed(2) %></strong><a class="primary-button" href="/purchase">Purchase</a><a href="/marketplace">Continue shopping</a></aside></section><% } %></main><%- include('partials/footer') %>
