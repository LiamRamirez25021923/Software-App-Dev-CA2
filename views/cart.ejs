<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shopping Cart – bouTime</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .cart-container {
      background-color: #f8f9fa;
      padding: 20px;
      border-radius: 8px;
    }
    .cart-item {
      background-color: white;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 15px;
      display: flex;
      gap: 15px;
      align-items: center;
    }
    .cart-item img {
      width: 100px;
      height: 100px;
      object-fit: contain;
      background-color: #f8f9fa;
      border-radius: 4px;
    }
    .cart-item-details {
      flex: 1;
    }
    .cart-item-name {
      font-size: 18px;
      font-weight: 600;
      color: #242e57;
    }
    .cart-item-size {
      color: #666;
      font-size: 14px;
    }
    .cart-item-price {
      color: #ffb300;
      font-weight: 600;
      font-size: 16px;
    }
    .quantity-control {
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .quantity-control button {
      padding: 2px 8px;
      background-color: #242e57;
      color: #ffb300;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 600;
    }
    .quantity-control input {
      width: 50px;
      padding: 5px;
      text-align: center;
      border: 1px solid #ddd;
      border-radius: 4px;
    }
    .remove-btn {
      background-color: #dc3545;
      color: white;
      border: none;
      padding: 8px 12px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 600;
    }
    .remove-btn:hover {
      background-color: #c82333;
    }
    .cart-summary {
      background-color: white;
      border: 2px solid #242e57;
      border-radius: 8px;
      padding: 20px;
      margin-top: 30px;
    }
    .summary-row {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      font-size: 16px;
    }
    .summary-total {
      font-size: 24px;
      font-weight: 700;
      color: #ffb300;
      border-top: 2px solid #e0e0e0;
      padding-top: 15px;
      margin-top: 15px;
    }
    .empty-cart {
      text-align: center;
      padding: 40px;
      background-color: white;
      border-radius: 8px;
    }
    .empty-cart p {
      font-size: 18px;
      color: #666;
      margin-bottom: 20px;
    }
    .checkout-btn {
      background-color: #ffb300;
      color: #242e57;
      border: none;
      padding: 12px 30px;
      font-weight: 700;
      border-radius: 4px;
      cursor: pointer;
      font-size: 16px;
      width: 100%;
    }
    .checkout-btn:hover {
      background-color: #e6a000;
    }
    .continue-shopping-btn {
      background-color: #242e57;
      color: #ffb300;
      border: none;
      padding: 12px 30px;
      font-weight: 600;
      border-radius: 4px;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      margin-top: 20px;
    }
    .continue-shopping-btn:hover {
      background-color: #1a1f3a;
      color: #ffb300;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <h2 class="text-center fw-bold mb-4" style="color: #242e57;">Your Shopping Cart</h2>

    <% if (cart && cart.length > 0) { %>
      <div class="cart-container">
        <% cart.forEach((item) => { %>
          <div class="cart-item">
            <img src="/images/<%= item.product.image %>" alt="<%= item.product.name %>">
            
            <div class="cart-item-details">
              <div class="cart-item-name"><%= item.product.name %></div>
              <% if (item.size) { %>
                <div class="cart-item-size">Size: <%= item.size %></div>
              <% } %>
              <div class="cart-item-price">$<%= item.product.price.toFixed(2) %> each</div>
            </div>

            <div>
              <form action="/cart/update/<%= item.id %>" method="POST" style="display: flex; gap: 10px; align-items: center;">
                <% if (item.size) { %>
                  <input type="hidden" name="size" value="<%= item.size %>">
                <% } %>
                <div class="quantity-control">
                  <button type="button" onclick="decreaseQty(this)">-</button>
                  <input type="number" name="quantity" value="<%= item.quantity %>" min="1">
                  <button type="button" onclick="increaseQty(this)">+</button>
                </div>
                <button type="submit" class="btn btn-sm" style="background-color: #242e57; color: #ffb300;">Update</button>
              </form>
            </div>

            <div style="text-align: right;">
              <div style="font-size: 16px; font-weight: 600; color: #242e57;">
                $<%= (item.product.price * item.quantity).toFixed(2) %>
              </div>
              <form action="/cart/remove/<%= item.id %>" method="POST" style="margin-top: 10px;">
                <% if (item.size) { %>
                  <input type="hidden" name="size" value="<%= item.size %>">
                <% } %>
                <button type="submit" class="remove-btn">Remove</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="cart-summary">
        <div class="summary-row">
          <span>Subtotal:</span>
          <span>$<%= total %></span>
        </div>
        <div class="summary-row">
          <span>Shipping:</span>
          <span>Free</span>
        </div>
        <div class="summary-row">
          <span>Tax:</span>
          <span>$0.00</span>
        </div>
        <div class="summary-row summary-total">
          <span>Total:</span>
          <span>$<%= total %></span>
        </div>
        <form action="/checkout" method="GET">
          <button type="submit" class="checkout-btn">Proceed to Checkout</button>
        </form>
        <a href="/" class="continue-shopping-btn">Continue Shopping</a>
      </div>
    <% } else { %>
      <div class="empty-cart">
        <p>Your cart is empty</p>
        <a href="/" class="continue-shopping-btn">Continue Shopping</a>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>

  <script>
    function increaseQty(btn) {
      const input = btn.parentElement.querySelector('input[name="quantity"]');
      input.value = parseInt(input.value) + 1;
    }

    function decreaseQty(btn) {
      const input = btn.parentElement.querySelector('input[name="quantity"]');
      if (parseInt(input.value) > 1) {
        input.value = parseInt(input.value) - 1;
      }
    }
  </script>
</body>
</html>
