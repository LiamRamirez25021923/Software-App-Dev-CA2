<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> – bouTime</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <div class="row g-5 align-items-center">

      <div class="col-md-6">
        <img src="/images/<%= product.image %>" class="img-fluid rounded shadow" alt="<%= product.name %>">
      </div>

      <div class="col-md-6">
        <span class="badge bg-secondary mb-2"><%= product.category.charAt(0).toUpperCase() + product.category.slice(1) %></span>
        <h1 class="mb-2"><%= product.name %></h1>
        <p class="text-success fw-bold fs-3">$<%= product.price.toFixed(2) %></p>
        <p class="text-muted"><%= product.description %></p>

        <ul class="list-group list-group-flush mb-4">
          <% product.features.forEach(feature => { %>
            <li class="list-group-item"><%= feature %></li>
          <% }) %>
        </ul>

        <% const sizeLabelMap = { gloves: '(oz)', shoes: '(US)', headgear: '(size)', groinwear: '(size)', handwraps: '(length)' }; %>
        <% if (product.sizes && product.sizes.length) { %>
        <div class="mb-3">
          <label for="sizeSelect" class="form-label fw-semibold">
            Select Option <%= sizeLabelMap[product.category] || '' %>
          </label>
          <select class="form-select" id="sizeSelect" name="size" style="width:150px">
            <% product.sizes.forEach(size => { %>
              <option><%= size %></option>
            <% }) %>
          </select>
        </div>
        <% } %>

        <div class="mb-3">
          <label for="quantityInput" class="form-label fw-semibold">Quantity</label>
          <input type="number" class="form-control" id="quantityInput" name="quantity" value="1" min="1" style="width:100px">
        </div>

        <form action="/cart/add/<%= product.id %>" method="POST" class="d-flex gap-2">
          <input type="hidden" name="size" id="formSize" value="">
          <input type="hidden" name="quantity" id="formQuantity" value="">
          <input type="hidden" name="redirect" value="/product/<%= product.id %>">
          <button type="submit" class="btn btn-lg" style="background-color: #ffb300; color: #242e57; font-weight: 700;">🛒 Add to Cart</button>
          <a href="/<%= product.category %>" class="btn btn-outline-secondary btn-lg">← Back</a>
        </form>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    // Update hidden form fields when size or quantity changes
    const sizeSelect = document.getElementById('sizeSelect');
    const quantityInput = document.getElementById('quantityInput');
    const formSize = document.getElementById('formSize');
    const formQuantity = document.getElementById('formQuantity');
    const form = document.querySelector('form');

    function updateFormValues() {
      if (formSize) {
        formSize.value = sizeSelect ? sizeSelect.value : '';
      }
      if (formQuantity) {
        formQuantity.value = quantityInput.value;
      }
    }

    if (sizeSelect) {
      sizeSelect.addEventListener('change', updateFormValues);
    }
    quantityInput.addEventListener('change', updateFormValues);

    // Set initial values
    updateFormValues();

    // Update on form submit to ensure latest values
    if (form) {
      form.addEventListener('submit', updateFormValues);
    }
  </script>
</body>
</html>