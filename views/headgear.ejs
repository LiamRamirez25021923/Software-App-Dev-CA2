<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Headgear – bouTime</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container mt-4">
    <h1 class="mb-1">Headgear</h1>
    <p class="text-muted mb-4">Protect your head with premium padded headgear built for sparring and competition.</p>

    <div class="row row-cols-1 row-cols-md-3 g-4">
      <% headgear.forEach(item => { %>
        <div class="col">
          <div class="card h-100 shadow-sm" style="display: flex; flex-direction: column;">
            <img src="/images/<%= item.image %>" class="card-img-top" style="height:220px; object-fit:contain; background-color:#f8f9fa;" alt="<%= item.name %>">
            <div class="card-body d-flex flex-column">
              <span class="badge bg-secondary mb-2" style="width:fit-content">Headgear</span>
              <% if (item.isUserListing) { %>
                <span class="badge bg-warning text-dark mb-2" style="width:fit-content;">Marketplace</span>
              <% } %>
              <h5 class="card-title"><%= item.name %></h5>
              <p class="card-text text-muted"><%= item.description.substring(0, 70) %>...</p>
              <p class="fw-bold fs-5" style="color: #ffb300;">$<%= item.price.toFixed(2) %></p>
              
              <div style="margin-top: auto;">
                <form action="/cart/add/<%= item.id %>" method="POST" style="margin-bottom: 10px;">
                  <input type="hidden" name="quantity" value="1">
                  <input type="hidden" name="redirect" value="/headgear">
                  <button type="submit" class="btn btn-sm w-100" style="background-color: #ffb300; color: #242e57; font-weight: 700;">🛒 Quick Add</button>
                </form>
                <a href="<%= item.isUserListing ? '/listing/' + item.id : '/product/' + item.id %>" class="btn btn-outline-secondary btn-sm w-100">View Details</a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
