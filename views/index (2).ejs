<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Supermarket App</title>
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Supermarket App</a>
      <div class="collapse navbar-collapse">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link" href="/addProduct">Add new product</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="text-center"><h2>Products from Supermarket App Database</h2></div>

    <table class="table table-hover small text-center align-middle mt-4">
      <thead>
        <tr>
          <th>Product Name</th>
          <th>Product Image</th>
          <th>Quantity</th>
          <th>Price</th>
          <th>Edit</th>
          <th>Delete</th>
        </tr>
      </thead>
      <tbody>
        <% for (const product of products) { %>
          <tr>
            <td><a href="/product/<%= product.productId %>"><%= product.productName %></a></td>
            <td>
              <% if (product.hasUploadedImage) { %>
                <img src="/product-image/<%= product.productId %>" style="max-width:80px; max-height:80px; object-fit:contain;" alt="<%= product.productName %>">
              <% } else if (product.image) { %>
                <img src="/images/<%= product.image %>" style="max-width:80px; max-height:80px; object-fit:contain;" alt="<%= product.productName %>">
              <% } else { %>
                <span class="text-muted">No image</span>
              <% } %>
            </td>
            <td><%= product.quantity %></td>
            <td>$<%= Number(product.price).toFixed(2) %></td>
            <td><a href="/editProduct/<%= product.productId %>">Edit</a></td>
            <td><a href="/deleteProduct/<%= product.productId %>" onclick="return confirm('Are you sure you want to delete this product?')">Delete</a></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
