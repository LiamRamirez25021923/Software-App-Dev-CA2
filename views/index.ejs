<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>bouTime – Home</title>
  <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="shortcut icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="icon" href="/images/icon/bouTime.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container mt-4">

    <h2 class="text-center fw-bold my-4">By boxers, for boxers</h2>
    <div id="carouselExample" class="carousel slide mb-5" data-bs-ride="carousel">
      <div class="carousel-inner rounded shadow">
        <div class="carousel-item active">
          <img src="/images/RyanGarcia2.jpg" class="d-block w-100" style="max-height:400px; object-fit:cover;" alt="Ryan Garcia">
          <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
            <p class="mb-0 fw-semibold">Ryan Garcia wearing RIVAL vs Duarte</p>
          </div>
        </div>
        <div class="carousel-item">
          <img src="/images/Crawford.jpg" class="d-block w-100" style="max-height:400px; object-fit:cover;" alt="Crawford">
          <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
            <p class="mb-0 fw-semibold">Crawford wearing EVERLAST vs Errol Spence</p>
          </div>
        </div>
        <div class="carousel-item">
          <img src="/images/Mayweather.jpg" class="d-block w-100" style="max-height:400px; object-fit:cover;" alt="Mayweather">
          <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
            <p class="mb-0 fw-semibold">Mayweather wearing MAYWEATHER x HAYABUSA</p>
          </div>
        </div>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
      </button>
    </div>

    <h1 class="mb-4">Pick your poison...</h1>
    <div class="row row-cols-1 row-cols-md-3 g-4">
      <% products.concat(userListings).forEach(item => { %>
        <div class="col">
          <div class="card h-100 shadow-sm" style="display: flex; flex-direction: column;">
            <img src="/images/<%= item.image %>" class="card-img-top" style="height:220px; object-fit:contain; background-color:#f8f9fa;" alt="<%= item.name %>">
            <div class="card-body d-flex flex-column">
              <span class="badge bg-secondary mb-2" style="width:fit-content"><%= item.category.charAt(0).toUpperCase() + item.category.slice(1) %></span>
              <% if (item.isUserListing) { %>
                <span class="badge bg-warning text-dark mb-2" style="width:fit-content;">Marketplace</span>
              <% } %>
              <h5 class="card-title"><%= item.name %></h5>
              <p class="card-text text-muted"><%= item.description.substring(0, 60) %>...</p>
              <p class="fw-bold text-success fs-5" style="color: #ffb300 !important;">$<%= item.price.toFixed(2) %></p>
              
              <div style="margin-top: auto;">
                <form action="/cart/add/<%= item.id %>" method="POST" style="margin-bottom: 10px;">
                  <input type="hidden" name="quantity" value="1">
                  <input type="hidden" name="redirect" value="/">
                  <button type="submit" class="btn btn-sm w-100" style="background-color: #ffb300; color: #242e57; font-weight: 700;">🛒 Quick Add</button>
                </form>
                <a href="<%= item.isUserListing ? '/listing/' + item.id : '/product/' + item.id %>" class="btn btn-outline-secondary btn-sm w-100">View Details</a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

  </div>

  <%- include('partials/footer') %>
</body>
</html>