<%- include('partials/header') %><%- include('partials/nav') %><main class="content-section page-top"><p class="eyebrow">FINAL STAGE</p><h1>Checkout</h1><div class="checkout-layout"><form class="stack-form checkout-form pixel-panel" action="/purchase" method="POST"><h2>Delivery and payment</h2><% if(error){ %><div class="alert"><%= error %></div><% } %><label>Name<input name="name" value="<%= values.name %>" required></label><label>Email<input type="email" name="email" value="<%= values.email %>" required></label><label>Address<textarea name="address" rows="4" required><%= values.address %></textarea></label><label>Card number<input name="cardNumber" inputmode="numeric" autocomplete="cc-number" minlength="13" maxlength="23" placeholder="1234 5678 9012 3456" required></label><p class="security-note">Demo checkout only. The application stores only the final four digits, never the complete card number.</p><button class="primary-button">Confirm purchase</button></form><aside class="cart-summary pixel-panel"><h2>Items</h2><% items.forEach(item=>{ %><p><%= item.title %> × <%= item.selectedQuantity %><br><strong>$<%= item.lineTotal.toFixed(2) %></strong></p><% }) %><hr><p>Total</p><strong class="price">$<%= total.toFixed(2) %></strong></aside></div></main><%- include('partials/footer') %>
